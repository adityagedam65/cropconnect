# CropConnect Frontend - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (no trailing slash)
VITE_BACKEND_URL=http://localhost:8001

# Set to "true" to enable whole-site AI translation when GEMINI_API_KEY is configured
VITE_PUBLIC_TRANSLATION_ENABLED=false

# Optional fallback translation endpoint (LibreTranslate-compatible)
VITE_PUBLIC_TRANSLATION_FALLBACK_URL=

# Sentry DSN for frontend error monitoring.
# Also set VITE_SENTRY_DSN in Vercel → Settings → Environment Variables.
# Leave blank to disable Sentry (errors will not be reported).
VITE_SENTRY_DSN=
